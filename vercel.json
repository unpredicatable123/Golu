{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "if [ -d web ]; then cd web; fi; npm ci",
  "buildCommand": "if [ -d web ]; then cd web && npm run build && rm -rf ../build && mv build ../build; else npm run build; fi",
  "outputDirectory": "build",
  "headers": [
    {
      "source": "/(frames|frames-mobile|doors|props|audio)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_app/immutable/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
